{
  "name": "termhat",
  "version": "1.0.0",
  "description": "An AI-powered CLI that translates plain English into safe terminal commands.",
  "main": "./dist/termhat.js",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/termhat.js",
    "dev": "tsx src/termhat.ts",
    "link": "npm run build && npm link",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Priyanshu (https://github.com/Priiyanshu45)",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "termhat": "./dist/termhat.js",
    "th": "./dist/termhat.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@google/genai": "^3.2.0",
    "clipboardy": "^5.3.2",
    "commander": "^15.1.0",
    "conf": "^16.0.0",
    "figlet": "^1.12.0",
    "picocolors": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priiyanshu45/termhat.git"
  },
  "homepage": "https://github.com/Priiyanshu45/termhat#readme",
  
  "keywords": [
    "cli",
    "terminal",
    "shell",
    "command-line",
    "ai",
    "natural-language",
    "developer-tools"
  ]
}
